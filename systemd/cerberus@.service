[Unit]
Description=Cerberus IoT Gateway Instance %i
Requires=cerberus.socket

[Service]
StandardInput=socket
StandardOutput=journal
StandardError=journal
ExecStart=/home/regragui/cerberus-gateway/venv/bin/python /home/regragui/cerberus-gateway/src/main.py

DynamicUser=yes
ProtectSystem=strict
NoNewPrivileges=yes
MemoryMax=256M
